{
  "info": {
    "name": "StellarTrace API",
    "description": "Fraud/anomaly triage API. The AI advisory endpoint is strictly advisory (see docs/ai-boundary.md) — only /decision, with an Investigator/Admin token, changes alert status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "investigatorToken", "value": "dev-investigator-token" },
    { "key": "alertId", "value": "" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Metrics",
      "request": { "method": "GET", "url": "{{baseUrl}}/metrics" }
    },
    {
      "name": "Ingest + evaluate transaction",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/transactions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tx_hash\": \"postman-large-transfer\",\n  \"ledger_sequence\": 100,\n  \"source_account\": \"GALICE\",\n  \"destination_account\": \"GBOB\",\n  \"asset\": { \"type\": \"native\" },\n  \"amount\": \"50000\",\n  \"timestamp\": \"2026-01-01T00:00:00Z\",\n  \"is_soroban_invocation\": false,\n  \"contract_id\": null,\n  \"metadata\": {}\n}"
        }
      }
    },
    {
      "name": "List alerts",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/alerts" }
    },
    {
      "name": "Get alert",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/alerts/{{alertId}}" }
    },
    {
      "name": "Get AI advisory investigation (advisory only)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/alerts/{{alertId}}/ai-investigation" }
    },
    {
      "name": "Submit investigator decision",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{investigatorToken}}" }
        ],
        "url": "{{baseUrl}}/api/alerts/{{alertId}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"confirmed_suspicious\",\n  \"notes\": \"Verified with off-chain KYC records.\"\n}"
        }
      }
    },
    {
      "name": "Get audit trail for alert",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/alerts/{{alertId}}/audit" }
    },
    {
      "name": "Verify audit chain integrity",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/audit/verify" }
    }
  ]
}
