# Copy to .env and adjust. StellarTrace reads these from the process
# environment; how you get them there (direnv, docker-compose, systemd
# EnvironmentFile, ...) is up to your deployment.

# Address the API server binds to.
STELLARTRACE_BIND_ADDR=0.0.0.0:8080

# Bearer tokens: token:role:investigator_id, comma-separated.
# Roles: viewer | investigator | admin
# CHANGE THESE before deploying anywhere beyond your own laptop.
STELLARTRACE_API_TOKENS=change-me-investigator-token:investigator:alice,change-me-admin-token:admin:bob

# Enables the real Claude-backed AI advisor. Leave unset to run with the
# advisory fallback only (rules-based detection is unaffected either way).
ANTHROPIC_API_KEY=

# Optional: path to a TOML file overriding default rule thresholds.
# See config/default_rules.toml for the full schema.
STELLARTRACE_RULES_CONFIG=config/default_rules.toml

# Optional: directory for periodic alert/audit snapshot persistence.
# Leave unset to run purely in-memory (no snapshot files written/read).
STELLARTRACE_DATA_DIR=

# tracing_subscriber::EnvFilter string.
RUST_LOG=info
